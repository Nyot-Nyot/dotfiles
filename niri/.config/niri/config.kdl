// =============================================================================
// Niri Config — Nyot-Nyot
// ~/.config/niri/config.kdl
// Managed via GNU Stow: ~/.dotfiles/niri/.config/niri/config.kdl
// =============================================================================

// -----------------------------------------------------------------------------
// INPUT
// -----------------------------------------------------------------------------
input {
    keyboard {
        repeat-delay 250
        repeat-rate 40
    }

    touchpad {
        tap
        natural-scroll
        // dwt
        // accel-speed 0.2
    }

    mouse {
        // natural-scroll
    }
}

// -----------------------------------------------------------------------------
// OUTPUT
// -----------------------------------------------------------------------------
output "eDP-1" {
    scale 1.0
}

// Contoh monitor eksternal:
// output "HDMI-A-1" {
//     mode "1920x1080@60.000"
//     scale 1.0
//     position x=1920 y=0
// }

// -----------------------------------------------------------------------------
// LAYOUT
// -----------------------------------------------------------------------------
layout {
    gaps 10

    border {
        width 1
        active-color   "#7aa2f7"
        inactive-color "#3b4261"
    }

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    // shadow {
    //     on
    //     softness 30
    //     spread 5
    //     offset x=0 y=5
    //     color "#00000064"
    // }
}

// -----------------------------------------------------------------------------
// STARTUP APPS
// -----------------------------------------------------------------------------
spawn-at-startup "noctalia"
spawn-at-startup "xwayland-satellite"

// -----------------------------------------------------------------------------
// WINDOW RULES
// -----------------------------------------------------------------------------
window-rule {
    geometry-corner-radius 10
    clip-to-geometry true
}

window-rule {
    match app-id="dev.noctalia.Noctalia"
    open-floating true
    default-column-width  { fixed 1080; }
    default-window-height { fixed 920; }
}

window-rule {
    match app-id=r#"^org\.gnome\.World\.Secrets$"#
    open-floating true
}

window-rule {
    match title=r#"^Picture-in-Picture$"#
    open-floating true
}

// -----------------------------------------------------------------------------
// LAYER RULES
// -----------------------------------------------------------------------------
layer-rule {
    match namespace="^noctalia-desktop-widget-"
    place-within-backdrop true
}

// -----------------------------------------------------------------------------
// DEBUG (NVIDIA Hybrid)
// -----------------------------------------------------------------------------
// debug {
//    render-drm-device "/dev/dri/renderD129"
//    wait-for-frame-completion-before-queueing
//    honor-xdg-activation-with-invalid-serial
// }

// -----------------------------------------------------------------------------
// KEYBINDS
// -----------------------------------------------------------------------------
binds {
    // ===== SISTEM & APLIKASI =====
    Mod+Return         { spawn "ptyxis"; }                                   // Terminal
    Mod+B              { spawn "google-chrome-stable"; }                     // Browser
    Mod+E              { spawn "nautilus"; }                                 // File manager
    Mod+Space          { spawn-sh "noctalia msg panel-toggle launcher"; }    // Launcher
    Mod+S              { spawn-sh "noctalia msg panel-toggle control-center"; }
    Mod+Comma          { spawn-sh "noctalia msg settings-toggle"; }          // Settings Noctalia
    Alt+Tab            { spawn-sh "noctalia msg window-switcher hold"; }     // Window Switcher

    // ===== SESSION (Noctalia native) =====
    Mod+Escape         { spawn-sh "noctalia msg session lock"; }             // Lock screen
    Mod+Ctrl+L         { spawn-sh "noctalia msg session logout"; }           // Logout cepat
    Mod+Shift+Z        { spawn-sh "noctalia msg session suspend"; }          // Suspend
    Mod+Shift+Q        { spawn "wlogout"; }                                  // Power menu (grid)
    Mod+Shift+E        { quit; }                                             // Emergency quit Niri

    // ===== OVERVIEW & HELP =====
    Mod+O              { toggle-overview; }                                  // Overview Niri
    Mod+Shift+Slash    { show-hotkey-overlay; }                              // Lihat semua keybind

    // ===== SCREENSHOT =====
    Mod+Shift+S        { spawn-sh "grim -g \"$(slurp)\" - | wl-copy"; }      // Region → clipboard
    Print              { spawn-sh "grim - | wl-copy"; }                      // Fullscreen → clipboard

    // ===== NAVIGASI FOKUS (Home Row: HJKL) =====
    Mod+H              { focus-column-left; }
    Mod+L              { focus-column-right; }
    Mod+K              { focus-window-up; }
    Mod+J              { focus-window-down; }

    // ===== PINDAHKAN JENDELA =====
    Mod+Shift+H        { move-column-left; }
    Mod+Shift+L        { move-column-right; }
    Mod+Shift+K        { move-window-up; }
    Mod+Shift+J        { move-window-down; }

    // ===== MANAJEMEN JENDELA =====
    Mod+W              { close-window; }
    Mod+F              { fullscreen-window; }
    Mod+A              { toggle-window-floating; }
    Mod+R              { switch-preset-column-width; }
    Mod+C              { center-column; }
    Mod+Minus          { set-column-width "-10%"; }
    Mod+Equal          { set-column-width "+10%"; }

    // ===== WORKSPACE =====
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }

    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }

    // Navigasi workspace relatif
    Mod+Tab            { focus-workspace-down; }
    Mod+Shift+Tab      { focus-workspace-up; }

    // ===== AUDIO & BRIGHTNESS (tombol Fn) =====
    XF86AudioRaiseVolume  { spawn-sh "noctalia msg volume-up"; }
    XF86AudioLowerVolume  { spawn-sh "noctalia msg volume-down"; }
    XF86AudioMute         { spawn-sh "noctalia msg volume-mute"; }
    XF86MonBrightnessUp   { spawn-sh "noctalia msg brightness-up"; }
    XF86MonBrightnessDown { spawn-sh "noctalia msg brightness-down"; }
}

// -----------------------------------------------------------------------------
// OVERVIEW
// -----------------------------------------------------------------------------
overview {
    backdrop-color "#1a1b26"
}

// -----------------------------------------------------------------------------
// ANIMASI
// -----------------------------------------------------------------------------
animations {
    workspace-switch {
        spring damping-ratio=1.0 stiffness=500 epsilon=0.0001
    }
    window-open {
        duration-ms 150
        curve "ease-out-expo"
    }
    window-close {
        duration-ms 150
        curve "ease-out-quad"
    }
}

// -----------------------------------------------------------------------------
// ENVIRONMENT (opsional)
// -----------------------------------------------------------------------------
environment {
    // "MOZ_ENABLE_WAYLAND" "1"
    // "ELECTRON_OZONE_PLATFORM_HINT" "auto"
    // "QT_QPA_PLATFORM" "wayland"
}



